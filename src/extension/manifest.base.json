{
  "manifest_version": 3,
  "name": "InterviewCopilot",
  "version": "0.1.0",
  "description": "Companion overlay for the InterviewCopilot desktop app. Shows suggested answers inside your meeting tab.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:5480/*"],
  "action": { "default_popup": "popup.html", "default_title": "InterviewCopilot" },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*",
        "https://*.webex.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
