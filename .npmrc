# ============================================================
# .npmrc — InterviewCopilot
# Enforces pnpm as sole package manager with security hardening
# ============================================================

# Enforce exact versions — no ^ or ~ prefixes
save-exact=true

# Dependency install scripts (a supply-chain attack vector) are blocked by pnpm 10
# by default. Only packages listed under onlyBuiltDependencies in
# pnpm-workspace.yaml (electron, esbuild) may run theirs. Don't add ignore-scripts=true:
# it would also block those two and leave Electron without its binary.

# Strict peer dependencies — fail on mismatches instead of silently resolving
strict-peer-dependencies=true

# Prevent accidental publish to npm registry
publish=false

# Only hoist what's necessary, reduce phantom dependency risk
shamefully-hoist=false

# Auto-install peers
auto-install-peers=true
